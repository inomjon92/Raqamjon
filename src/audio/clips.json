 "al_s0": "Ali maktabga bordi.",
 "al_s1": "Onam non yopdi.",
 "al_s2": "Mushuk sut ichdi.",
 "al_s3": "Bogʻda gullar ochildi.",
 "al_s4": "Biz kitob oʻqiymiz.",
 "al_s5": "Quyosh charaqlab turibdi.",
 "al_s6": "Dadam mashina haydaydi.",
 "al_s7": "Kuz kelib barglar sargʻaydi.",
 "al_s8": "Bolalar hovlida oʻynashdi.",
 "al_s9": "Qor yogʻdi.",
 "al_s10": "Buvim menga ertak aytdi.",
 "al_s11": "Olma daraxtda pishdi.",
 "al_s12": "Kuchukcha dumini likillatdi.",
 "al_s13": "Singlim rasm chizdi.",
 "al_s14": "Biz parkka sayrga bordik.",
 "al_s15": "Tovuq joʻjalarini chaqirdi.",
 "al_s16": "Akam velosiped minadi.",
 "al_s17": "Doʻstim menga sovgʻa berdi.",
 "al_s18": "Men har kuni ertalab badantarbiya qilaman.",
 "al_s19": "Opam bogʻda chiroyli gullar ekdi.",
 "al_s20": "Biz yozda dengiz boʻyiga bordik.",
 "al_t0": "Ali bogʻga bordi. U yerda olma terdi. Olmalar qizil va shirin edi.",
 "al_t0q0": "Ali bogʻda nima terdi?",
 "al_t0q1": "Olmalar qanday edi?",
 "al_t1": "Mushukcha Momiq oppoq rangda. U sut ichishni yaxshi koʻradi. Kechasi esa divanda uxlaydi.",
 "al_t1q0": "Momiq qanday rangda?",
 "al_t1q1": "Momiq nimani yaxshi koʻradi?",
 "al_t2": "Bugun yakshanba. Zarina buvisinikiga bordi. Buvisi unga issiq non va qaymoq berdi.",
 "al_t2q0": "Zarina kimnikiga bordi?",
 "al_t2q1": "Bugun qaysi kun?",
 "al_t3": "Qish keldi. Koʻchalarni qor qopladi. Bolalar qorbobo yasashdi va chana uchishdi.",
 "al_t3q0": "Qaysi fasl keldi?",
 "al_t3q1": "Bolalar nima yasashdi?",
 "al_t4": "Sardorning qizil velosipedi bor. U har kuni ertalab parkda velosiped haydaydi.",
 "al_t4q0": "Velosiped qanday rangda?",
 "al_t4q1": "Sardor qayerda velosiped haydaydi?",
 "al_t5": "Bahorda daraxtlar gulladi. Asalarilar gullardan nektar yigʻishdi. Ular shirin asal tayyorlaydi.",
 "al_t5q0": "Asalarilar nima tayyorlaydi?",
 "al_t5q1": "Daraxtlar qachon gulladi?",
 "al_t6": "Dilnoza maktabga ketayotib yoʻlda kichkina kuchukchani koʻrdi. U kuchukchani uyiga olib keldi va unga Doʻmboq deb ism qoʻydi.",
 "al_t6q0": "Dilnoza nimani koʻrdi?",
 "al_t6q1": "Kuchukchaning ismi nima?",
 "al_t7": "Bobom bogʻda pomidor, bodring va sabzi ekdi. Men unga suv quyishga yordam berdim.",
 "al_t7q0": "Bobom qayerda ekin ekdi?",
 "al_t7q1": "Men nima qildim?",
