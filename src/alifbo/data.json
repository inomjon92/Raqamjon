 "sentences": [
  "Ali maktabga bordi.",
  "Onam non yopdi.",
  "Mushuk sut ichdi.",
  "Bogʻda gullar ochildi.",
  "Biz kitob oʻqiymiz.",
  "Quyosh charaqlab turibdi.",
  "Dadam mashina haydaydi.",
  "Kuz kelib barglar sargʻaydi.",
  "Bolalar hovlida oʻynashdi.",
  "Qor yogʻdi.",
  "Buvim menga ertak aytdi.",
  "Olma daraxtda pishdi.",
  "Kuchukcha dumini likillatdi.",
  "Singlim rasm chizdi.",
  "Biz parkka sayrga bordik.",
  "Tovuq joʻjalarini chaqirdi.",
  "Akam velosiped minadi.",
  "Doʻstim menga sovgʻa berdi.",
  "Men har kuni ertalab badantarbiya qilaman.",
  "Opam bogʻda chiroyli gullar ekdi.",
  "Biz yozda dengiz boʻyiga bordik."
 ],
 "texts": [
  {
   "t": "Ali bogʻga bordi. U yerda olma terdi. Olmalar qizil va shirin edi.",
   "q": [
    [
     "Ali bogʻda nima terdi?",
     [
      "olma",
      "uzum",
      "nok"
     ]
    ],
    [
     "Olmalar qanday edi?",
     [
      "qizil va shirin",
      "yashil va nordon",
      "sariq va qattiq"
     ]
    ]
   ]
  },
  {
   "t": "Mushukcha Momiq oppoq rangda. U sut ichishni yaxshi koʻradi. Kechasi esa divanda uxlaydi.",
   "q": [
    [
     "Momiq qanday rangda?",
     [
      "oppoq",
      "qora",
      "kulrang"
     ]
    ],
    [
     "Momiq nimani yaxshi koʻradi?",
     [
      "sut ichishni",
      "suvda suzishni",
      "daraxtga chiqishni"
     ]
    ]
   ]
  },
  {
   "t": "Bugun yakshanba. Zarina buvisinikiga bordi. Buvisi unga issiq non va qaymoq berdi.",
   "q": [
    [
     "Zarina kimnikiga bordi?",
     [
      "buvisinikiga",
      "doʻstinikiga",
      "maktabga"
     ]
    ],
    [
     "Bugun qaysi kun?",
     [
      "yakshanba",
      "dushanba",
      "juma"
     ]
    ]
   ]
  },
  {
   "t": "Qish keldi. Koʻchalarni qor qopladi. Bolalar qorbobo yasashdi va chana uchishdi.",
   "q": [
    [
     "Qaysi fasl keldi?",
     [
      "qish",
      "yoz",
      "bahor"
     ]
    ],
    [
     "Bolalar nima yasashdi?",
     [
      "qorbobo",
      "uycha",
      "samolyot"
     ]
    ]
   ]
  },
  {
   "t": "Sardorning qizil velosipedi bor. U har kuni ertalab parkda velosiped haydaydi.",
   "q": [
    [
     "Velosiped qanday rangda?",
     [
      "qizil",
      "koʻk",
      "yashil"
     ]
    ],
    [
     "Sardor qayerda velosiped haydaydi?",
     [
      "parkda",
      "maktabda",
      "uyda"
     ]
    ]
   ]
  },
  {
   "t": "Bahorda daraxtlar gulladi. Asalarilar gullardan nektar yigʻishdi. Ular shirin asal tayyorlaydi.",
   "q": [
    [
     "Asalarilar nima tayyorlaydi?",
     [
      "asal",
      "sut",
      "non"
     ]
    ],
    [
     "Daraxtlar qachon gulladi?",
     [
      "bahorda",
      "qishda",
      "kuzda"
     ]
    ]
   ]
  },
  {
   "t": "Dilnoza maktabga ketayotib yoʻlda kichkina kuchukchani koʻrdi. U kuchukchani uyiga olib keldi va unga Doʻmboq deb ism qoʻydi.",
   "q": [
    [
     "Dilnoza nimani koʻrdi?",
     [
      "kuchukchani",
      "mushukchani",
      "qushchani"
     ]
    ],
    [
     "Kuchukchaning ismi nima?",
     [
      "Doʻmboq",
      "Momiq",
      "Oqtosh"
     ]
    ]
   ]
  },
  {
   "t": "Bobom bogʻda pomidor, bodring va sabzi ekdi. Men unga suv quyishga yordam berdim.",
   "q": [
    [
     "Bobom qayerda ekin ekdi?",
     [
      "bogʻda",
      "dalada",
      "maktabda"
     ]
    ],
    [
     "Men nima qildim?",
     [
      "suv quydim",
